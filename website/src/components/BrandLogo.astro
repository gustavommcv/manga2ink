---
import { getImage, Image } from 'astro:assets';

import logo from '../../../assets/branding/mangabound.png';
import { stringsFor } from '../i18n/strings';

const label = stringsFor(Astro.locals.starlightRoute.lang).brandLogo.openFullSize;
const fullSize = await getImage({ src: logo, format: 'webp', quality: 'max' });
---

<a class="brand-logo" href={fullSize.src} aria-label={label} title={label}>
  <Image
    src={logo}
    alt=""
    width={256}
    height={256}
    densities={[1, 2, 3, 4]}
    format="webp"
    quality="max"
  />
</a>

<style>
  .brand-logo {
    display: block;
    width: min(100%, 16rem);
    margin: 1.5rem auto;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
</style>
