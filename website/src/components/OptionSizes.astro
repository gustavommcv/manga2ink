---
import manifest from '../assets/options/manifest.json';
import { stringsFor } from '../i18n/strings';
import OptionCredit from './OptionCredit.astro';

interface Props {
  /** The example in src/assets/options/manifest.json. */
  id: string;
}

const { id } = Astro.props;
const { numberLocale } = stringsFor(Astro.locals.starlightRoute.lang);
const example = (
  manifest.examples as Record<string, (typeof manifest.examples)[keyof typeof manifest.examples]>
)[id];
if (!example) throw new Error(`There is no option example called ${id}. Run npm run site:options.`);
const words = stringsFor(Astro.locals.starlightRoute.lang).optionSizes;
const files = example.kind === 'files';
const heads = {
  region: words.region(files),
  setting: words.setting,
  flag: words.flag,
  size: words.size(files),
  kept: words.kept(files),
};
const group = example.variants[0].label.split(':')[0];
const source = example.source;
const caption = words.caption(files, source.width, source.height);
const number = new Intl.NumberFormat(numberLocale, { maximumFractionDigits: 1 });
const fileSize = (bytes: number) =>
  bytes >= 1024 * 1024
    ? `${number.format(bytes / 1024 / 1024)} MB`
    : `${Math.round(bytes / 1024)} KB`;
const percent = new Intl.NumberFormat(numberLocale, { maximumFractionDigits: 1 });
const unchanged = words.unchanged;
const rows = example.variants.map((variant) => {
  const sized = variant as {
    width: number;
    height: number;
    keptPercent?: number;
    pageBytes: number;
    fileType?: string;
    sameAsInput?: boolean;
  };
  return {
    label: variant.label,
    flags: variant.flags.length > 0 ? variant.flags.join(' ') : words.noFlag,
    size: files
      ? `${sized.width} × ${sized.height}, ${sized.fileType}${sized.sameAsInput ? ` (${unchanged})` : ''}`
      : `${sized.width} × ${sized.height}`,
    kept: files ? fileSize(sized.pageBytes) : `${percent.format(sized.keptPercent ?? 100)}%`,
  };
});
---

<div
  class="option-sizes not-content"
  data-option-sizes={id}
  role="region"
  aria-label={`${group}: ${heads.region}`}
  tabindex="0"
>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{heads.setting}</th>
        <th scope="col">{heads.flag}</th>
        <th scope="col">{heads.size}</th>
        <th scope="col">{heads.kept}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            <code>{row.flags}</code>
          </td>
          <td>{row.size}</td>
          <td>{row.kept}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<OptionCredit from={example.sources} mangapress={manifest.mangapress} />

<style>
  .option-sizes {
    overflow-x: auto;
    margin-block: 1.5rem;
  }
  .option-sizes:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  caption {
    caption-side: bottom;
    padding-block-start: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: start;
  }
  th,
  td {
    padding: 0.375rem 0.75rem 0.375rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    text-align: start;
    vertical-align: baseline;
  }
  thead th {
    color: var(--sl-color-white);
  }
  tbody th {
    color: var(--sl-color-gray-1);
    font-weight: 400;
  }
  code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    overflow-wrap: anywhere;
  }
  td:nth-child(3),
  td:nth-child(4) {
    font-variant-numeric: tabular-nums;
  }
  td:nth-child(4) {
    white-space: nowrap;
  }
</style>
