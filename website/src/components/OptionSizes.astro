---
import manifest from '../assets/options/manifest.json';
import OptionCredit from './OptionCredit.astro';

interface Props {
  /** The example in src/assets/options/manifest.json. */
  id: string;
}

const { id } = Astro.props;
const example = (
  manifest.examples as Record<string, (typeof manifest.examples)[keyof typeof manifest.examples]>
)[id];
if (!example) throw new Error(`There is no option example called ${id}. Run npm run site:options.`);
const portuguese = Astro.locals.starlightRoute.lang === 'pt-BR';
const files = example.kind === 'files';
const heads = portuguese
  ? {
      region: files ? 'tamanhos de arquivo medidos' : 'tamanhos medidos',
      setting: 'Opção',
      flag: 'No terminal',
      size: files ? 'Página' : 'Tamanho da página',
      kept: files ? 'Tamanho do arquivo' : 'Fica da página',
    }
  : {
      region: files ? 'measured file sizes' : 'measured sizes',
      setting: 'Setting',
      flag: 'On the command line',
      size: files ? 'Page' : 'Page size',
      kept: files ? 'File size' : 'Of the page kept',
    };
const group = example.variants[0].label.split(':')[0];
const source = example.source;
const caption = portuguese
  ? files
    ? `Página de origem: ${source.width} × ${source.height} px. Os tamanhos são os do arquivo da página que o mangapress gravou.`
    : `Página de origem: ${source.width} × ${source.height} px. As páginas não são ampliadas, então o tamanho mostra o que foi cortado.`
  : files
    ? `Source page: ${source.width} × ${source.height} px. The sizes are those of the file of the page mangapress wrote.`
    : `Source page: ${source.width} × ${source.height} px. The pages are not enlarged, so the size shows what was cropped.`;
const number = new Intl.NumberFormat(portuguese ? 'pt-BR' : 'en', { maximumFractionDigits: 1 });
const fileSize = (bytes: number) =>
  bytes >= 1024 * 1024
    ? `${number.format(bytes / 1024 / 1024)} MB`
    : `${Math.round(bytes / 1024)} KB`;
const percent = new Intl.NumberFormat(portuguese ? 'pt-BR' : 'en', { maximumFractionDigits: 1 });
const unchanged = portuguese ? 'a própria entrada, sem mudança' : 'the input, unchanged';
const rows = example.variants.map((variant) => {
  const sized = variant as {
    width: number;
    height: number;
    keptPercent?: number;
    pageBytes: number;
    fileType?: string;
    sameAsInput?: boolean;
  };
  return {
    label: variant.label,
    flags: variant.flags.length > 0 ? variant.flags.join(' ') : portuguese ? 'sem flag' : 'no flag',
    size: files
      ? `${sized.width} × ${sized.height}, ${sized.fileType}${sized.sameAsInput ? ` (${unchanged})` : ''}`
      : `${sized.width} × ${sized.height}`,
    kept: files ? fileSize(sized.pageBytes) : `${percent.format(sized.keptPercent ?? 100)}%`,
  };
});
---

<div
  class="option-sizes not-content"
  data-option-sizes={id}
  role="region"
  aria-label={`${group}: ${heads.region}`}
  tabindex="0"
>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{heads.setting}</th>
        <th scope="col">{heads.flag}</th>
        <th scope="col">{heads.size}</th>
        <th scope="col">{heads.kept}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            <code>{row.flags}</code>
          </td>
          <td>{row.size}</td>
          <td>{row.kept}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<OptionCredit from={example.sources} mangapress={manifest.mangapress} />

<style>
  .option-sizes {
    overflow-x: auto;
    margin-block: 1.5rem;
  }
  .option-sizes:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  caption {
    caption-side: bottom;
    padding-block-start: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: start;
  }
  th,
  td {
    padding: 0.375rem 0.75rem 0.375rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    text-align: start;
    vertical-align: baseline;
  }
  thead th {
    color: var(--sl-color-white);
  }
  tbody th {
    color: var(--sl-color-gray-1);
    font-weight: 400;
  }
  code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    overflow-wrap: anywhere;
  }
  td:nth-child(3),
  td:nth-child(4) {
    font-variant-numeric: tabular-nums;
  }
  td:nth-child(4) {
    white-space: nowrap;
  }
</style>
