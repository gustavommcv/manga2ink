---
import manifest from '../assets/options/manifest.json';
import { stringsFor } from '../i18n/strings';

interface Props {
  /** The example in src/assets/options/manifest.json, of the kind `book`. */
  id: string;
  /** What each row is, by the variant's id, in the language of the page; English falls back to the manifest. */
  labels?: Record<string, string>;
}

type Fact =
  | 'title'
  | 'author'
  | 'language'
  | 'direction'
  | 'fileName'
  | 'comicInfo'
  | 'pages'
  | 'source'
  | 'firstPage'
  | 'cover';
interface Facts {
  fileName: string;
  title: string | null;
  author: string | null;
  language: string | null;
  direction: 'ltr' | 'rtl' | null;
  comicInfo: 'none' | 'copy' | 'changed';
  pages?: string[];
  source: string;
  firstPage: string | null;
  cover: { width: number; height: number; color: boolean } | null;
}

const { id, labels } = Astro.props;
const example = (
  manifest.examples as Record<string, (typeof manifest.examples)[keyof typeof manifest.examples]>
)[id];
if (!example) throw new Error(`There is no option example called ${id}. Run npm run site:options.`);
const columns = (example as { columns?: Fact[] }).columns;
if (!columns) throw new Error(`The option example ${id} is not a book example.`);
const lang = Astro.locals.starlightRoute.lang;
const words = stringsFor(lang).optionBook;

/** A flag value with a space in it is quoted, as it would be typed. */
const flagsText = (flags: string[]) =>
  flags.map((token) => (/\s/.test(token) ? `"${token}"` : token)).join(' ');

function show(column: Fact, facts: Facts): { text: string; missing: boolean } {
  const value = facts[column];
  if (column === 'cover' && facts.cover)
    return {
      text: `${facts.cover.width} × ${facts.cover.height}, ${facts.cover.color ? words.color : words.gray}`,
      missing: false,
    };
  if (column === 'firstPage' && value === null) return { text: words.notRead, missing: true };
  if (column === 'comicInfo')
    return {
      text: facts.comicInfo === 'none' ? words.no : words[facts.comicInfo],
      missing: false,
    };
  if (column === 'pages') {
    const pages = facts.pages ?? [];
    return {
      text: `${pages.length} ${pages.length === 1 ? words.page : words.pages}: ${pages.join(', ')}`,
      missing: false,
    };
  }
  if (value === null || value === undefined) return { text: words.missing, missing: true };
  return {
    text: column === 'direction' ? words[value as 'ltr' | 'rtl'] : String(value),
    missing: false,
  };
}

const rows = example.variants.map((variant) => {
  const row = variant as unknown as { id: string; label: string; flags: string[]; facts: Facts };
  const label = labels?.[row.id];
  if (lang !== 'en' && !label) throw new Error(`The example ${id} needs a label for ${row.id}.`);
  return {
    label: label ?? row.label,
    flags: row.flags.length > 0 ? flagsText(row.flags) : words.noFlag,
    cells: columns.map((column) => show(column, row.facts)),
  };
});
const region = `${words.region}: ${columns.map((column) => words.heads[column].toLowerCase()).join(', ')}`;
---

<div
  class="option-book not-content"
  data-option-book={id}
  role="region"
  aria-label={region}
  tabindex="0"
>
  <table>
    <caption>{words.caption(manifest.mangapress)}</caption>
    <thead>
      <tr>
        <th scope="col">{words.setting}</th>
        <th scope="col">{words.flag}</th>
        {columns.map((column) => (
          <th scope="col">{words.heads[column]}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            <code>{row.flags}</code>
          </td>
          {row.cells.map((cell) => (
            <td class:list={{ missing: cell.missing }}>{cell.text}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .option-book {
    overflow-x: auto;
    margin-block: 1.5rem;
  }
  .option-book:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  caption {
    caption-side: bottom;
    padding-block-start: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: start;
  }
  th,
  td {
    padding: 0.375rem 0.75rem 0.375rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    text-align: start;
    vertical-align: baseline;
  }
  thead th {
    color: var(--sl-color-white);
  }
  tbody th {
    color: var(--sl-color-gray-1);
    font-weight: 400;
  }
  code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    overflow-wrap: anywhere;
  }
  td.missing {
    color: var(--sl-color-gray-3);
  }
</style>
