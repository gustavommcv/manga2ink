---
import manifest from '../assets/options/manifest.json';

interface Props {
  /** The example in src/assets/options/manifest.json, of the kind `book`. */
  id: string;
  /** What each row is, by the variant's id, in the language of the page; English falls back to the manifest. */
  labels?: Record<string, string>;
}

type Fact = 'title' | 'author' | 'language' | 'direction' | 'fileName' | 'comicInfo' | 'pages';
interface Facts {
  fileName: string;
  title: string | null;
  author: string | null;
  language: string | null;
  direction: 'ltr' | 'rtl' | null;
  comicInfo: 'none' | 'copy' | 'changed';
  pages?: string[];
}

const { id, labels } = Astro.props;
const example = (
  manifest.examples as Record<string, (typeof manifest.examples)[keyof typeof manifest.examples]>
)[id];
if (!example) throw new Error(`There is no option example called ${id}. Run npm run site:options.`);
const columns = (example as { columns?: Fact[] }).columns;
if (!columns) throw new Error(`The option example ${id} is not a book example.`);
const portuguese = Astro.locals.starlightRoute.lang === 'pt-BR';

const words = portuguese
  ? {
      setting: 'Opção',
      flag: 'No terminal',
      noFlag: 'sem flag',
      missing: 'não consta do livro',
      no: 'não',
      copy: 'sim, a da entrada, sem mudança',
      changed: 'sim, alterada',
      ltr: 'da esquerda para a direita (ltr)',
      rtl: 'da direita para a esquerda (rtl)',
      page: 'página',
      pages: 'páginas',
      region: 'valores medidos',
      caption: `Medido com o mangapress ${manifest.mangapress}: cada valor é lido de volta do livro que ele gravou.`,
      heads: {
        title: 'Título do livro',
        author: 'Autor',
        language: 'Idioma',
        direction: 'Direção de leitura',
        fileName: 'Nome do arquivo',
        comicInfo: 'ComicInfo.xml no livro',
        pages: 'Páginas',
      },
    }
  : {
      setting: 'Setting',
      flag: 'On the command line',
      noFlag: 'no flag',
      missing: 'not in the book',
      no: 'no',
      copy: 'yes, the input’s own, unchanged',
      changed: 'yes, changed',
      ltr: 'left to right (ltr)',
      rtl: 'right to left (rtl)',
      page: 'page',
      pages: 'pages',
      region: 'measured values',
      caption: `Measured with mangapress ${manifest.mangapress}: each value is read back from the book it wrote.`,
      heads: {
        title: 'Book title',
        author: 'Author',
        language: 'Language',
        direction: 'Reading direction',
        fileName: 'File name',
        comicInfo: 'ComicInfo.xml in the book',
        pages: 'Pages',
      },
    };

/** A flag value with a space in it is quoted, as it would be typed. */
const flagsText = (flags: string[]) =>
  flags.map((token) => (/\s/.test(token) ? `"${token}"` : token)).join(' ');

function show(column: Fact, facts: Facts): { text: string; missing: boolean } {
  const value = facts[column];
  if (column === 'comicInfo')
    return {
      text: facts.comicInfo === 'none' ? words.no : words[facts.comicInfo],
      missing: false,
    };
  if (column === 'pages') {
    const pages = facts.pages ?? [];
    return {
      text: `${pages.length} ${pages.length === 1 ? words.page : words.pages}: ${pages.join(', ')}`,
      missing: false,
    };
  }
  if (value === null || value === undefined) return { text: words.missing, missing: true };
  return {
    text: column === 'direction' ? words[value as 'ltr' | 'rtl'] : String(value),
    missing: false,
  };
}

const rows = example.variants.map((variant) => {
  const row = variant as unknown as { id: string; label: string; flags: string[]; facts: Facts };
  const label = labels?.[row.id];
  if (portuguese && !label) throw new Error(`The example ${id} needs a label for ${row.id}.`);
  return {
    label: label ?? row.label,
    flags: row.flags.length > 0 ? flagsText(row.flags) : words.noFlag,
    cells: columns.map((column) => show(column, row.facts)),
  };
});
const region = `${words.region}: ${columns.map((column) => words.heads[column].toLowerCase()).join(', ')}`;
---

<div
  class="option-book not-content"
  data-option-book={id}
  role="region"
  aria-label={region}
  tabindex="0"
>
  <table>
    <caption>{words.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{words.setting}</th>
        <th scope="col">{words.flag}</th>
        {columns.map((column) => (
          <th scope="col">{words.heads[column]}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            <code>{row.flags}</code>
          </td>
          {row.cells.map((cell) => (
            <td class:list={{ missing: cell.missing }}>{cell.text}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .option-book {
    overflow-x: auto;
    margin-block: 1.5rem;
  }
  .option-book:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  caption {
    caption-side: bottom;
    padding-block-start: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: start;
  }
  th,
  td {
    padding: 0.375rem 0.75rem 0.375rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    text-align: start;
    vertical-align: baseline;
  }
  thead th {
    color: var(--sl-color-white);
  }
  tbody th {
    color: var(--sl-color-gray-1);
    font-weight: 400;
  }
  code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    overflow-wrap: anywhere;
  }
  td.missing {
    color: var(--sl-color-gray-3);
  }
</style>
