---
import { LinkButton } from '@astrojs/starlight/components';

import { stringsFor } from '../i18n/strings';
import { publishedRelease } from '../published-release.mjs';

interface Props {
  platform: 'windows' | 'macOS' | 'linux';
}

const { platform } = Astro.props;
const release = await publishedRelease;
const words = stringsFor(Astro.locals.starlightRoute.lang).releaseDownloads;
const choices = {
  windows: ['windowsInstaller', 'windowsPortable'],
  macOS: ['macOS'],
  linux: ['debian', 'fedora', 'arch'],
} as const;
---

<div class="release-downloads" data-release-tag={release.tag}>
  <div class="buttons">
    {choices[platform].map((key, index) => (
      <LinkButton
        href={release.assets[key]}
        variant={platform !== 'linux' && index === 0 ? 'primary' : 'secondary'}
        icon="download"
        iconPlacement="start"
      >
        {words.buttons[key]}
      </LinkButton>
    ))}
  </div>
  <p class="release-info">
    {words.latest} <strong>{release.tag}</strong>
    {release.prerelease && words.prerelease}
    {' · '}
    <a href={release.notes}>{words.notes}</a>
    {' · '}
    <a href={release.assets.checksums}>SHA256SUMS</a>
  </p>
</div>

<style>
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .buttons :global(.sl-link-button) {
    margin: 0;
  }

  .release-info {
    font-size: var(--sl-text-sm);
  }
</style>
