---
// The links of the header (and of the menu on a narrow screen): a heart that leads to the page where
// the project can be supported, named in the language of the page, and after it, on its right,
// Starlight's own social links, from `social` in astro.config.mjs (GitHub).
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { Icon } from '@astrojs/starlight/components';

import { supportUrl } from '../../site.config.mjs';
import { stringsFor } from '../i18n/strings';

const label = stringsFor(Astro.locals.starlightRoute).support.label;
---

<a href={supportUrl} rel="noopener" class="sl-flex support" title={label}>
  <span class="sr-only">{label}</span>
  <Icon name="heart" />
</a>
<Default />

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
  }
</style>
