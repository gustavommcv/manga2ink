---
import type { ImageMetadata } from 'astro';

import manifest from '../assets/options/manifest.json';
import OptionCredit from './OptionCredit.astro';

interface Props {
  /** The example in src/assets/options/manifest.json. */
  id: string;
  /** What each variant's picture shows, by the variant's id; the alt text is written for the page. */
  alt: Record<string, string>;
}

const { id, alt } = Astro.props;
const example = (
  manifest.examples as Record<string, (typeof manifest.examples)[keyof typeof manifest.examples]>
)[id];
if (!example) throw new Error(`There is no option example called ${id}. Run npm run site:options.`);
const portuguese = Astro.locals.starlightRoute.lang === 'pt-BR';
const pictures = import.meta.glob<ImageMetadata>('../assets/options/*.webp', {
  eager: true,
  import: 'default',
});
const rows = (example as { layout?: string }).layout === 'rows';
const screenLabel = (example as { screenLabel?: string }).screenLabel;
const fullSize = portuguese ? 'Abrir imagem em tamanho maior' : 'Open the larger image';

const variants = example.variants.map((variant) => {
  const meta = pictures[`../assets/options/${(variant as { file?: string }).file}`];
  if (!meta) throw new Error(`Missing picture for ${id}/${variant.id}. Run npm run site:options.`);
  if (!alt[variant.id]) throw new Error(`The example ${id} needs alt text for ${variant.id}.`);
  const stats = variant as {
    width: number;
    height: number;
    darkest?: number;
    mean?: number;
    pageBytes: number;
    original?: boolean;
    plain?: boolean;
    pages?: { width: number; height: number }[];
  };
  const sizes = (stats.pages ?? [stats]).map((page) => `${page.width} × ${page.height}`);
  const count = stats.pages?.length ?? 1;
  const noun = portuguese ? (count === 1 ? 'página' : 'páginas') : count === 1 ? 'page' : 'pages';
  return {
    ...variant,
    meta,
    alt: alt[variant.id],
    fileSize: `${Math.round(stats.pageBytes / 1024)} KB`,
    flagsText: stats.original ? null : variant.flags.length > 0 ? variant.flags.join(' ') : null,
    original: stats.original === true,
    plain: stats.plain === true,
    shape: stats.pages
      ? `${count} ${noun}: ${sizes.join(portuguese ? ', ' : ', ')} px`
      : `${sizes[0]} px`,
    tone:
      stats.mean === undefined
        ? null
        : portuguese
          ? `Pixel mais escuro ${stats.darkest}, brilho médio ${stats.mean} de 255`
          : `Darkest pixel ${stats.darkest}, average brightness ${stats.mean} of 255`,
  };
});
---

<div class:list={['option-example', { rows }]} data-option-example={id}>
  {variants.map((variant) => (
    <figure data-plain={variant.plain || undefined}>
      <a href={variant.meta.src} title={fullSize}>
        <img
          src={variant.meta.src}
          width={variant.meta.width}
          height={variant.meta.height}
          alt={variant.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption>
        <strong>{variant.label}</strong>
        <code>
          {variant.original
            ? portuguese
              ? 'sem conversão'
              : 'not converted'
            : (variant.flagsText ?? (portuguese ? 'sem flag' : 'no flag'))}
        </code>
        {!variant.plain && (
          <span>
            {variant.shape}, {variant.fileSize}
          </span>
        )}
        {variant.tone && <span>{variant.tone}</span>}
      </figcaption>
    </figure>
  ))}
</div>
{screenLabel && (
  <p class="screen-note">
    {portuguese
      ? `O cinza é a tela em volta da página: ${screenLabel} pixels.`
      : `The gray is the screen around the page: ${screenLabel} pixels.`}
  </p>
)}
<OptionCredit from={example.sources} mangapress={manifest.mangapress} />

<style>
  .screen-note {
    margin-block: -0.75rem 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .option-example {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .option-example.rows {
    grid-template-columns: 1fr;
  }
  figure {
    margin: 0;
  }
  a {
    display: block;
    overflow: hidden;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-border-radius, 0.5rem);
    box-shadow: var(--sl-shadow-sm);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-block-start: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  figcaption code {
    align-self: flex-start;
    font-size: var(--sl-text-xs);
  }
</style>
